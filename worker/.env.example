# Local OmniPresence worker — copy to worker/.env (never commit secrets)

OMNI_WORKER_PORT=8787
APP_BASE_URL=http://localhost:3000

# Token encryption (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# ENCRYPTION_KEY=optional-separate-key

# YouTube / Google OAuth (Desktop or Web client with redirect below)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/accounts/youtube/callback

# Meta / Facebook Login for Business
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/accounts/meta/callback
# META_LOGIN_CONFIG_ID=
# META_OAUTH_SCOPES=pages_show_list,business_management,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,instagram_manage_insights
# After changing scopes, reconnect Meta on Clients.
